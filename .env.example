DATABASE_PATH=data/face_identity.db

FACE_MATCH_THRESHOLD=0.45
FACE_MATCH_MARGIN=0.05
FACE_DETECTOR_BACKEND=scrfd
FACE_LOW_LIGHT_ENHANCEMENT=lime
FACE_RECOGNITION_INTERVAL=5
FACE_CONFIRMATION_VOTES=3
FACE_VOTE_WINDOW=5
TRACK_TTL_FRAMES=150

# Enrollment photographs must contain a clear face at least this large.
MIN_FACE_SIZE=48
FACE_DETECTION_SCORE_THRESHOLD=0.70

# Live distant-face handling. Upscaling is used only for ROI detection;
# identity quality is measured in the original camera pixels.
LIVE_FACE_DETECTION_MIN_SIZE=12
LIVE_FACE_IDENTITY_MIN_SIZE=32
LIVE_FACE_ROI_UPSCALE=2.0
LIVE_FACE_ROI_RATIO=0.55
LIVE_FACE_ROI_SCORE_THRESHOLD=0.60
# Maximum enlarged ROI side; native crops are never downscaled.
LIVE_FACE_ROI_MAX_DIMENSION=640
FACE_DIAGNOSTIC_LOG_INTERVAL=300

ENROLLMENT_VARIANTS=5
MAX_EMBEDDINGS_PER_PERSON=10

YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE=0.35
YOLO_IMAGE_SIZE=640
TRACKER_CONFIG=botsort.yaml

CAMERA_SOURCE=0
NDI_SOURCE_NAME=
# Use 2x2 when one NDI source contains four camera quadrants.
NDI_LAYOUT=single
NDI_DISCOVERY_TIMEOUT_MS=10000
NDI_CAPTURE_TIMEOUT_MS=1000

LOG_LEVEL=INFO
